CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_AUTO_UPDATE_RCP=y
# IKEA/production bulbs need CSA PAA roots in paa_cert/, not Chip-Test-PAA.
CONFIG_TEST_ATTESTATION_TRUST_STORE=n
CONFIG_SPIFFS_ATTESTATION_TRUST_STORE=y
# K149 UART: host RX=GPIO10, TX=GPIO17, RCP reset=GPIO7, boot=GPIO18.
# If the combined controller+OTBR image boot-loops, set:
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
# Default 10 fills up once several Thread devices advertise Matter._tcp via SRP.
CONFIG_MDNS_MAX_SERVICES=32
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
