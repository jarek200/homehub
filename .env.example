# Copy to .env.local and fill in values for your AWS account.
# None of these belong in git.

# Public origin of the web app, no trailing slash.
# Example: https://homehub.example.com
APP_URL=

# Domain used for the SES identity and the From address (noreply@APP_DOMAIN).
# Leave empty to skip SES. Example: example.com
APP_DOMAIN=

# Optional SNS email for gateway household alerts. Leave empty to skip the subscription.
ALERT_EMAIL=

# Route 53 hosted zone that owns APP_DOMAIN, when the app uses a custom domain.
APPS_HOSTED_ZONE_ID=

# Cross-account role allowed to write DNS records in that zone.
DNS_ROLE_ARN=

# Shared API key for non-Cognito clients. Prefer `sst secret set RestApiKey` in deployed stages.
REST_API_KEY=

# Optional AWS CLI profile overrides. Defaults are homehub-int and homehub-prod.
# AWS_PROFILE_INT=homehub-int
# AWS_PROFILE_PROD=homehub-prod
# DNS_SOURCE_PROFILE=admin
