{
  "name": "sst-monorepo-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "pnpm -r exec -- rm -rf node_modules .turbo 2>/dev/null || true && rm -rf node_modules .turbo && rm -f pnpm-lock.yaml",
    "build": "turbo run build",
    "dev": "pnpm sst dev --mode basic",
    "dev:tui": "pnpm sst dev",
    "dev:local": "pnpm --filter @sst-monorepo/web dev",
    "agent:python": "bash -lc 'cd packages/agent-core && if [ -x .venv/bin/python ]; then .venv/bin/python src/agent.py; else python3 src/agent.py; fi'",
    "deploy:dev": "pnpm sst deploy --stage dev",
    "deploy:stage": "pnpm sst deploy --stage stage",
    "deploy:prod": "pnpm sst deploy --stage prod",
    "remove:dev": "pnpm sst remove --stage dev",
    "remove:stage": "pnpm sst remove --stage stage",
    "sso": "aws sso login --sso-session=acme",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check . --write",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:turbo": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "turbo run codegen",
    "codegen:watch": "pnpm --filter @sst-monorepo/graphql codegen:watch",
    "prepare": "husky",
    "verify": "pnpm codegen && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "sst",
    "svelte",
    "sveltekit",
    "aws",
    "appsync",
    "graphql",
    "dynamodb",
    "cognito",
    "turborepo",
    "monorepo",
    "starter",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "SST monorepo starter \u2014 SvelteKit web app (landing, login, dashboard), AppSync, Cognito",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@pulumi/aws": "^7.36.0",
    "@pulumi/pulumi": "^3.252.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "sst": "^4.17.1",
    "turbo": "^2.10.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.20.0"
}
