# Webiny environment configuration
# Copy to .env.dev / .env.stage / .env.prod and fill in values.
# These files are gitignored — never commit actual credentials.

# AWS region where Webiny is deployed (must match your SST stage region)
AWS_REGION=us-east-1

# Pulumi backend (defaults to Webiny-managed S3 bucket — no change needed)
# PULUMI_SECRETS_PROVIDER=awskms://alias/webiny-pulumi-key

# Debug logging (optional)
# DEBUG=webiny:*
